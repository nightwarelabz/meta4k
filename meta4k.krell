    %hudy = fsub f64 %yr, 1080.0
    %hudy2 = fmul f64 %hudy, %hudy
    %hud2a = fdiv f64 %hudx2, 2250000.0
    %hud2b = fdiv f64 %hudy2, 2250000.0
