    %inwy0 = icmp.sge i64 y, 763
    %inwy1 = icmp.slt i64 y, 1397
    %iwx0 = zext i64 %inwx0
    %iwx1 = zext i64 %inwx1
    %iwy0 = zext i64 %inwy0
    %iwy1 = zext i64 %inwy1
    %iwa = and i64 %iwx0, %iwx1
    %iwb = and i64 %iwy0, %iwy1
    %iwc = and i64 %iwa, %iwb
    %inw = icmp.ne i64 %iwc, 0
    %ux0 = sub i64 x, 1810
    %uxn = icmp.slt i64 %ux0, 0
    %ux1 = select i64 %uxn, 0, %ux0
    %uxh = icmp.sgt i64 %ux1, 1859
    %ux = select i64 %uxh, 1859, %ux1
    %uy0 = sub i64 y, 763
    %uyn = icmp.slt i64 %uy0, 0
    %uy1 = select i64 %uyn, 0, %uy0
    %uyh = icmp.sgt i64 %uy1, 633
    %uy = select i64 %uyh, 633, %uy1
    %uu0 = mul i64 %ux, 2431
    %uu = sdiv i64 %uu0, 1860
    %uv0 = mul i64 %uy, 749
    %uv = sdiv i64 %uv0, 634
    %uu1a = add i64 %uu, 1
    %uu1h = icmp.sgt i64 %uu1a, 2430
    %uu1 = select i64 %uu1h, 2430, %uu1a
    %uv1a = add i64 %uv, 1
    %uv1h = icmp.sgt i64 %uv1a, 748
    %uv1 = select i64 %uv1h, 748, %uv1a
    %maskp = dataptr 1
    %ix1 = mul i64 %uv, 2431
    %ix1b = add i64 %ix1, %uu
    %by1 = sdiv i64 %ix1b, 8
    %bp1p = gep i8 %maskp, %by1
    %bv1 = load i8, %bp1p
    %bvx1 = zext i64 %bv1
    %bt1 = srem i64 %ix1b, 8
    %e10 = icmp.eq i64 %bt1, 0
    %dv10 = select i64 %e10, 1, 2
    %e12 = icmp.eq i64 %bt1, 2
    %dv11 = select i64 %e12, 4, %dv10
    %e13 = icmp.eq i64 %bt1, 3
    %dv12 = select i64 %e13, 8, %dv11
    %e14 = icmp.eq i64 %bt1, 4
    %dv13 = select i64 %e14, 16, %dv12
    %e15 = icmp.eq i64 %bt1, 5
    %dv14 = select i64 %e15, 32, %dv13
    %e16 = icmp.eq i64 %bt1, 6
    %dv15 = select i64 %e16, 64, %dv14
    %e17 = icmp.eq i64 %bt1, 7
