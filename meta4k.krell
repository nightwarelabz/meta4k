fn shade(ptr, ptr, ptr, i64, i64, ptr, f64, f64) -> i64 {
  entry(cbuf: ptr, wbuf: ptr, mbuf: ptr, x: i64, y: i64, out: ptr, bf: f64, fu: f64):
    %row = mul i64 y, 3840
    %idx = add i64 %row, x
    %p = gep i32 cbuf, %idx
    %av = load i32, %p
    %wp = gep i32 wbuf, %idx
    %bv = load i32, %wp
    %mp = gep i32 mbuf, %idx
    %mv = load i32, %mp
    %a64 = zext i64 %av
    %b64 = zext i64 %bv
    %m64 = zext i64 %mv
    %af = sitofp f64 %a64
    %bfv = sitofp f64 %b64
    %mf = sitofp f64 %m64
    %den = fadd f64 %af, 2600.0
    %tv = fdiv f64 %af, %den
    %te = call f64 sqrt(%tv)
    %gz = fcmp.oeq f64 %af, 0.0
    %asf = select f64 %gz, 1.0, %af
    %gr = fdiv f64 %bfv, %asf
    %xf = sitofp f64 x
    %yr = sitofp f64 y
    %in1a = fmul f64 %yr, 0.0013
    %in1b = fsub f64 %in1a, bf
    %in1 = call f64 sin(%in1b)
    %w1a = fmul f64 %xf, 0.0016
    %w1b = fmul f64 %in1, 1.9
    %w1c = fadd f64 %w1a, %w1b
    %w1d = fmul f64 bf, 2.0
    %w1e = fadd f64 %w1c, %w1d
    %w1 = call f64 sin(%w1e)
    %in2a = fmul f64 %xf, 0.0017
    %in2b = fmul f64 bf, 2.0
    %in2c = fadd f64 %in2a, %in2b
    %in2 = call f64 sin(%in2c)
    %w2a = fmul f64 %yr, 0.0011
    %w2b = fmul f64 %xf, 0.0007
    %w2c = fadd f64 %w2a, %w2b
    %w2d = fmul f64 %in2, 1.4
    %w2e = fadd f64 %w2c, %w2d
    %w2f = fmul f64 bf, 3.0
    %w2g = fsub f64 %w2e, %w2f
    %w2 = call f64 sin(%w2g)
    %in3a = fmul f64 %xf, 0.004
    %in3b = fmul f64 bf, 2.0
    %in3c = fsub f64 %in3a, %in3b
    %in3 = call f64 sin(%in3c)
    %w3a = fmul f64 %yr, 0.005
    %w3b = fmul f64 %in3, 0.9
    %w3c = fadd f64 %w3a, %w3b
    %w3d = fadd f64 %w3c, bf
    %w3 = call f64 sin(%w3d)
    %v1 = fmul f64 %w1, 0.28
    %v2 = fmul f64 %w2, 0.16
    %v3 = fmul f64 %w3, 0.10
    %v4 = fadd f64 %v1, %v2
    %v5 = fadd f64 %v4, %v3
    %v = fadd f64 %v5, 0.5
    %vlo = fcmp.olt f64 %v, 0.0
    %vc0 = select f64 %vlo, 0.0, %v
    %vhi = fcmp.ogt f64 %vc0, 1.0
    %vc = select f64 %vhi, 1.0, %vc0
    %bgr0 = fmul f64 %vc, 22.0
    %bgr = fadd f64 %bgr0, 233.0
    %bgg0 = fmul f64 %vc, 15.0
    %bgg = fadd f64 %bgg0, 240.0
    %bgb0 = fmul f64 %vc, 5.0
    %bgb = fadd f64 %bgb0, 250.0
    %ldx = fsub f64 %xf, 1200.0
    %ldx2 = fmul f64 %ldx, %ldx
    %ldy = fsub f64 %yr, 700.0
    %ldy2 = fmul f64 %ldy, %ldy
    %ld2a = fdiv f64 %ldx2, 5760000.0
    %ld2b = fdiv f64 %ldy2, 5760000.0
    %ld2 = fadd f64 %ld2a, %ld2b
    %ladd0 = fmul f64 %ld2, 0.4
    %ladd1 = fsub f64 1.0, %ladd0
    %ladd2 = fmul f64 %ladd1, 10.0
    %lneg = fcmp.olt f64 %ladd2, 0.0
    %ladd = select f64 %lneg, 0.0, %ladd2
    %bgrl0 = fadd f64 %bgr, %ladd
    %bggl0 = fadd f64 %bgg, %ladd
    %bgbl0 = fadd f64 %bgb, %ladd
    %au1a = fmul f64 %xf, 0.00045
    %au1b = fmul f64 %yr, 0.0003
    %au1c = fadd f64 %au1a, %au1b
    %au1d = fmul f64 bf, 2.0
    %au1e = fadd f64 %au1c, %au1d
    %aur1 = call f64 sin(%au1e)
    %au2a = fmul f64 %xf, -0.0003
    %au2b = fmul f64 %yr, 0.0005
    %au2c = fadd f64 %au2a, %au2b
